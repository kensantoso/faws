# faws e2e fixture — AWS shared credentials file. Static fake keys only; no
# rendering needed (nothing here is machine-specific). Proves that faws reads
# and merges both AWS files: legacy-base and creds-only-profile appear in
# `faws` (no filter) output even though they exist only here, not in
# e2e/aws/config.

[legacy-base]
aws_access_key_id     = AKIAFAKEBASE
aws_secret_access_key = fake-base-secret

[creds-only-profile]
aws_access_key_id     = AKIAFAKEONLY
aws_secret_access_key = fake-only-secret
