# faws e2e fixture — AWS config template.
#
# __FAWS_E2E_DIR__ is substituted with the absolute path of e2e/ when this
# file is rendered (by e2e/run-samples.sh into e2e/out/aws/config, and by
# e2e/e2e_test.go into a t.TempDir() copy). The rendered file is what makes
# this hermetic: every credential_process below runs our own fake vendor
# script instead of contacting AWS.
#
# Profiles carry granted_sso_* keys (what granted itself writes) rather than
# real sso_* keys, specifically so credential_process is the only thing the
# AWS CLI can resolve against — faws reads the granted_sso_* keys purely for
# filtering and display. Real sso_* keys alongside credential_process would
# create resolution ambiguity that doesn't exist in fixtures built the way
# granted actually builds them.

[sso-session acme]
sso_start_url = https://acme.awsapps.com/start
sso_region    = us-east-1

[services x]
s3 =
  endpoint_url = https://example.invalid

[profile acme-dev/ReadOnly]
granted_sso_start_url  = https://acme.awsapps.com/start
granted_sso_region     = us-east-1
granted_sso_account_id = 111111111111
granted_sso_role_name  = ReadOnly
region                 = us-east-1
credential_process     = __FAWS_E2E_DIR__/fake-credential-process acme-dev/ReadOnly

