# Item 5 regression fixture: a quoted section name containing a space.
# botocore shlex-parses [profile "..."] down to the unquoted name, so faws
# must both read it that way (pkg/awsconfig.stripQuotes) AND re-quote it on
# write (pkg/output.quoteSectionName) — writing it back bare makes
# `aws configure list-profiles` silently omit the profile. Distinct
# start-url/account/region values, so it can't accidentally be swept into any
# other sample case's acme/globex/readonly-style filter.
[profile "quoted space/Ops"]
granted_sso_start_url  = https://quotedspace.awsapps.com/start
granted_sso_region     = ca-central-1
granted_sso_account_id = 888888888888
granted_sso_role_name  = Ops
region                 = ca-central-1
credential_process     = __FAWS_E2E_DIR__/fake-credential-process "quoted space/Ops"

# Item 3 regression fixture: a botocore-nested setting (an indented
# continuation under a parent key). The parser used to flatten
# max_concurrent_requests/addressing_style into bogus top-level keys, so the
# vended file carried an empty `s3 =` plus two keys the CLI can never see —
# `aws configure get s3.max_concurrent_requests` returned nothing. Distinct
# org/account/region/role, so it can't be swept into any other sample case's
# filter.
[profile nested-settings/Viewer]
granted_sso_start_url  = https://nestedcfg.awsapps.com/start
granted_sso_region     = us-west-1
granted_sso_account_id = 999999999901
granted_sso_role_name  = Viewer
region                 = us-west-1
s3 =
  max_concurrent_requests = 20
  addressing_style = path
credential_process     = __FAWS_E2E_DIR__/fake-credential-process nested-settings/Viewer

# Not vended by any sample: a role-chain profile, present only to prove
# filter visibility (it is listed) without ever being resolved (resolving it
# for real would need a genuine sts:AssumeRole network call, which the
# sample runs never make).
[profile legacy-chain]
role_arn       = arn:aws:iam::777777777777:role/LegacyAdmin
source_profile = legacy-base

# Not vended by any sample: the regression fixture for the case-insensitive
# secret-exclusion fix. Its keys are UPPERCASE and its secret VALUE contains
# the string "readonly" — a correct faws must never match on it (see
# pkg/filter.SecretKeys and pkg/awsconfig.cutKV's key-lowercasing).
[profile shouty-static]
AWS_ACCESS_KEY_ID     = AKIAFAKEUPPERCASE
AWS_SECRET_ACCESS_KEY = uppercase-secret-containing-readonly-bait
