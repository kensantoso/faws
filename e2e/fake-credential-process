#!/bin/sh
# fake-credential-process — a fake `credential_process` vendor for the faws
# e2e fixture. It never contacts AWS or the network: given a profile name as
# $1, it prints the credential_process JSON contract
# (https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-role.html#cli-configure-role-credprocess)
# straight to stdout, using deterministic fake values derived from the
# profile name so different profiles are distinguishable in captured output.
#
# Every emitted value is obviously fake: access keys are prefixed ASIAFAKE,
# secrets fake-secret-, session tokens fake-session-.
set -eu

profile="${1:-unknown}"

# A short deterministic suffix derived from the profile name (POSIX cksum,
# available on both macOS and Linux), so e.g. acme-dev/ReadOnly and
# acme-dev/PowerUser get distinguishable-but-stable fake keys across runs.
suffix=$(printf '%s' "$profile" | cksum | cut -d' ' -f1)

# ~1 hour ahead, RFC3339/UTC. BSD date (macOS) uses -v; GNU date (Linux) uses
# -d. Try BSD first and fall back to GNU.
expiration=$(date -u -v+1H +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '+1 hour' +%Y-%m-%dT%H:%M:%SZ)

cat <<JSON
{
  "Version": 1,
  "AccessKeyId": "ASIAFAKE${suffix}",
  "SecretAccessKey": "fake-secret-${suffix}",
  "SessionToken": "fake-session-${suffix}",
  "Expiration": "${expiration}"
}
JSON
