#!/bin/sh
# slow-credential-process — a fake `credential_process` that never returns on
# its own, for the Ctrl-C regression test (item 2 of the review-2 brief).
#
# It backgrounds a grandchild (a plain `sleep`, standing in for whatever a
# real credential_process might spawn — a shell, a browser opener, etc.),
# records that grandchild's pid to $1, then blocks itself for a long time —
# exactly the "resolver waiting on something that will never come back on
# its own" shape that a Ctrl-C (not a timeout) is supposed to interrupt.
#
# Never touches the network. $1 is the pidfile path.
set -eu
pidfile="$1"

sh -c 'echo $$ > "'"$pidfile"'.grandchild"; exec sleep 300' &
echo $! >/dev/null # the backgrounded sh's own pid isn't what we track; see grandchild file above

sleep 300
